diff --git a/engine/utils/execute_utils.py b/engine/utils/execute_utils.py
index 55bc188..196d2e4 100644
--- a/engine/utils/execute_utils.py
+++ b/engine/utils/execute_utils.py
@@ -2,6 +2,30 @@ import subprocess
 import time
 import sys
 from pathlib import Path
+import os
+import re
+
+
+def _win_prepare(command: str):
+    """Windows: 'VAR=val ... python x.py' khong chay duoc voi cmd.exe.
+    Tach cac VAR=val dau lenh vao env, thay 'python' bang sys.executable,
+    va doi ':$PYTHONPATH' sang dau phan cach cua Windows."""
+    if os.name != 'nt':
+        return command, None
+    tokens = command.split()
+    env = dict(os.environ)
+    i = 0
+    while i < len(tokens) and re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', tokens[i]):
+        k, v = tokens[i].split('=', 1)
+        v = v.replace(':$PYTHONPATH', '').replace('$PYTHONPATH', '')
+        if k == 'PYTHONPATH' and os.environ.get('PYTHONPATH'):
+            v = v + os.pathsep + os.environ['PYTHONPATH']
+        env[k] = v
+        i += 1
+    rest = tokens[i:]
+    if rest and rest[0] == 'python':
+        rest[0] = sys.executable
+    return subprocess.list2cmdline(rest), env
 
 
 def execute_command(command: str, save_dir: str, timeout=None, dry_run: bool = False,
@@ -51,7 +75,8 @@ def execute_command(command: str, save_dir: str, timeout=None, dry_run: bool = F
     # print(f"[INFO] {returncode=}")
     # return returncode  # 0 is good
 
-    result = subprocess.run(command, shell=True, text=True, capture_output=True, timeout=timeout, cwd=cwd)
+    command, env = _win_prepare(command)
+    result = subprocess.run(command, shell=True, text=True, capture_output=True, timeout=timeout, cwd=cwd, env=env)
 
     with open(save_dir / "execute_out.txt", 'w') as f:
         f.write(result.stdout)
